# Copy this file to backend/.env and fill in credentials from your SMS provider.
# Never commit backend/.env or put these values in the browser app.
# For a reverse-proxy deployment, terminate TLS at the proxy and keep the Python
# API bound to loopback. Use the exact public frontend origin(s), comma-separated.
VITAL_ENV=production
VITAL_HOST=127.0.0.1
VITAL_ALLOWED_ORIGINS=https://vital.example.com
VITAL_COOKIE_SECURE=1
VITAL_SESSION_TTL_SECONDS=43200

VITAL_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITAL_TWILIO_AUTH_TOKEN=replace-with-private-auth-token
# Configure either an SMS-capable number owned by this Twilio account, or a
# Messaging Service SID whose sender pool contains an SMS-capable number.
VITAL_TWILIO_FROM_NUMBER=+15551234567
# VITAL_TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
